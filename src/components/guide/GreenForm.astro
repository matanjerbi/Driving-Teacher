---
import SectionHeader from '../SectionHeader.astro';
import { greenFormSteps } from '@/data/content';

const checklist = ['מוציאים לפני השיעור הראשון', 'בדיקת ראייה – חובה לכל תלמיד', 'תקועים בתהליך? נכוון אתכם'];
---

<section id="green-form" class="section">
  <div class="wrap green">
    <div>
      <SectionHeader eyebrow="לפני השיעור הראשון" eyebrowColor="var(--success)" title="טופס ירוק – מה זה ואיך מוציאים">
        הטופס הירוק הוא האישור שמאפשר להתחיל ללמוד נהיגה. היום הכול מקוון – בלי טופס נייר.
      </SectionHeader>

      <ol class="green__steps">
        {
          greenFormSteps.map((step) => (
            <li class="card">
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <aside class="green__card reveal">
      <h3>גם אם כבר יש לכם רישיון</h3>
      <p>מוסיפים דרגה לרישיון קיים? גם אז צריך טופס ירוק חדש לדרגה החדשה.</p>
      <ul>
        {checklist.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .green {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .green__steps {
    list-style: none;
    display: grid;
    gap: 14px;
    counter-reset: g;
  }

  .green__steps li {
    counter-increment: g;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    align-items: start;
    padding: 18px;
  }

  .green__steps li::before {
    content: counter(g);
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #e3f4ea;
    color: var(--success);
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 18px;
  }

  .green__steps h3 {
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 3px;
  }

  .green__steps p {
    color: var(--muted);
    font-size: 15.5px;
  }

  .green__card {
    background: linear-gradient(160deg, #173525, #11261b);
    border: 1px solid #2a5a3e;
    border-radius: 20px;
    padding: 30px;
  }

  .green__card h3 {
    font-size: 24px;
    font-weight: 900;
    margin-bottom: 10px;
    color: #9ff0c0;
  }

  .green__card p {
    color: #bfe3cd;
  }

  .green__card ul {
    list-style: none;
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .green__card li {
    display: flex;
    gap: 10px;
    color: #d9efe2;
  }

  .green__card li::before {
    content: '✓';
    color: var(--success);
    font-weight: 900;
  }

  @media (max-width: 860px) {
    .green {
      grid-template-columns: 1fr;
    }
  }
</style>
