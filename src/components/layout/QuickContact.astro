---
/** כפתור וואטסאפ צף (דסקטופ) + סרגל פעולה תחתון (נייד) */
import Icon from './Icon.astro';
import { telHref, waHref } from '@/data/site';
---

<a class="wa-float" href={waHref()} target="_blank" rel="noopener" aria-label="שליחת הודעה בוואטסאפ">
  <Icon name="whatsapp" />
</a>

<div class="mobile-bar">
  <a class="btn btn--wa" href={waHref()} target="_blank" rel="noopener"><Icon name="whatsapp" />וואטסאפ</a>
  <a class="btn btn--primary" href={telHref}><Icon name="phone" />חיוג</a>
</div>

<style>
  .wa-float {
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 60;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--wa);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    transition: transform 0.15s;
  }

  .wa-float:hover {
    transform: scale(1.06);
  }

  .wa-float :global(svg) {
    width: 32px;
    height: 32px;
  }

  .mobile-bar {
    display: none;
  }

  @media (max-width: 640px) {
    .wa-float {
      display: none;
    }

    .mobile-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      position: fixed;
      inset: auto 0 0 0;
      z-index: 60;
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
      background: rgba(18, 19, 21, 0.96);
      border-top: 1px solid var(--line);
      backdrop-filter: blur(8px);
    }

    .mobile-bar .btn {
      padding: 13px 10px;
      font-size: 16px;
    }
  }
</style>
