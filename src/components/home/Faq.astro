---
import SectionHeader from '../SectionHeader.astro';
import { faq } from '@/data/content';
---

<section id="faq" class="section section--alt">
  <div class="wrap">
    <SectionHeader eyebrow="שאלות נפוצות" title="שאלות שתלמידים שואלים" />

    <div class="faq">
      {
        faq.map((item) => (
          <details class="reveal">
            <summary>{item.q}</summary>
            <p>
              {item.a}
              {item.link && (
                <>
                  {' '}
                  <a class="text-link" href={item.link.href}>
                    {item.link.label}
                  </a>
                </>
              )}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 12px;
    max-width: 820px;
    margin-top: 36px;
  }

  details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0 22px;
  }

  details[open] {
    border-color: var(--line-strong);
  }

  summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 0;
    font-weight: 700;
    font-size: 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-size: 26px;
    font-weight: 400;
    color: var(--accent-text);
    transition: transform 0.2s;
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  details p {
    color: var(--muted);
    padding: 0 0 20px;
  }
</style>
