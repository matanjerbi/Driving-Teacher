---
import SectionHeader from '../SectionHeader.astro';
import { processSteps } from '@/data/content';
---

<section id="process" class="section section--alt">
  <div class="wrap">
    <SectionHeader eyebrow="הדרך לרישיון" title="איך זה עובד?">
      {processSteps.length} שלבים – ואנחנו מלווים אתכם לאורך כל הדרך.
      <a class="text-link" href="/guide/">פירוט מלא לפי סוג רישיון ←</a>
    </SectionHeader>

    <ol class="steps">
      {
        processSteps.map((step) => (
          <li class="step card reveal">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    counter-reset: step;
  }

  .step {
    padding: 28px 24px 26px;
    counter-increment: step;
  }

  .step::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent);
    color: #111;
    font-weight: 900;
    font-size: 18px;
    margin-bottom: 16px;
  }

  h3 {
    font-size: 19px;
    font-weight: 800;
    margin-bottom: 6px;
  }

  p {
    color: var(--muted);
    font-size: 15.5px;
  }

  @media (max-width: 1060px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
