---
import Icon from '../layout/Icon.astro';
import Motorcycle from './Motorcycle.astro';
import { site, telHref, waHref } from '@/data/site';
import { reviews, waMessages } from '@/data/content';

const featured = reviews.find((r) => r.highlight);
---

<section class="hero theme-dark">
  <div class="wrap hero__grid">
    <div>
      <div class="hero__tags">
        <span class="chip chip--accent">{site.city}</span>
        <span class="chip">A2 · A1 · A</span>
      </div>
      <h1>לומדים לרכוב נכון.<br /><em>עוברים טסט</em> בביטחון.</h1>
      <p class="lead hero__lead">
        שיעורי נהיגה על אופנועים וקטנועים בסבלנות ובקצב שלכם – גם אם אף פעם לא עליתם על אופנוע.
      </p>
      <div class="cta-row">
        <a class="btn btn--wa" href={waHref(waMessages.general)} target="_blank" rel="noopener">
          <Icon name="whatsapp" />שלחו הודעה בוואטסאפ
        </a>
        <a class="btn btn--ghost" href={telHref}><Icon name="phone" />חייגו עכשיו</a>
      </div>
    </div>

    {
      site.heroImage ? (
        <figure class="hero__photo reveal">
          <img src={site.heroImage.src} alt={site.heroImage.alt} width="640" height="544" loading="eager" />
        </figure>
      ) : (
        featured && (
          <aside class="quote reveal" aria-label="המלצת תלמיד">
            {featured.badge && <span class="quote__badge">{featured.badge}</span>}
            <div class="stars" aria-label="5 כוכבים">★★★★★</div>
            <blockquote>"{featured.highlight}"</blockquote>
            <cite>— {featured.name}, תלמיד</cite>
          </aside>
        )
      )
    }
  </div>

  <div class="hero__road road-line" aria-hidden="true"></div>
  <Motorcycle />
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 72px 0 150px;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -40% -10% auto auto;
    width: 720px;
    height: 720px;
    background: radial-gradient(circle, rgba(255, 194, 26, 0.14), transparent 62%);
    pointer-events: none;
  }

  .hero__road {
    position: absolute;
    inset: auto 0 34px 0;
    height: 6px;
    background: repeating-linear-gradient(90deg, var(--accent) 0 56px, transparent 56px 104px);
    opacity: 0.9;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }

  .hero__lead {
    margin: 20px 0 32px;
    max-width: 36ch;
  }

  .hero__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3.4;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
  }

  .quote {
    position: relative;
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 28px;
  }

  .quote blockquote {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.45;
    margin: 14px 0 18px;
  }

  .quote cite {
    font-style: normal;
    color: var(--muted);
    font-size: 15px;
  }

  .quote__badge {
    position: absolute;
    top: -14px;
    left: 24px;
    background: var(--accent);
    color: #111;
    font-weight: 800;
    font-size: 13px;
    padding: 6px 12px;
    border-radius: 999px;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 48px 0 130px;
    }
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
