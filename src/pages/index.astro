---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import TrustStrip from '@/components/home/TrustStrip.astro';
import LicenseCards from '@/components/home/LicenseCards.astro';
import WhyUs from '@/components/home/WhyUs.astro';
import ProcessSteps from '@/components/home/ProcessSteps.astro';
import Reviews from '@/components/home/Reviews.astro';
import Faq from '@/components/home/Faq.astro';
import Contact from '@/components/home/Contact.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { waMessages } from '@/data/content';
---

<BaseLayout current="/">
  <Hero />
  <TrustStrip />
  <LicenseCards />

  <section class="section section--tight">
    <div class="wrap">
      <CtaBanner
        title="יש לכם רישיון רכב 3 שנים ומעלה?"
        text="לקטנוע (A2) אין חובת שיעורים ואין תאוריה – רק מבחן שליטה במגרש. בפועל עושים כמה שיעורים כדי להגיע אליו בביטחון."
        buttonLabel="בדקו את המסלול שלכם ←"
        href="/guide/"
      />
    </div>
  </section>

  <WhyUs />

  <section class="section section--tight">
    <div class="wrap">
      <CtaBanner
        variant="dark"
        title="נכשלת בטסט אצל מורה אחר?"
        text="זה קורה, וזה לא אומר שאתה לא יכול. לפעמים צריך רק הסבר אחר ותיקון של כמה דברים קטנים. תלמידים הגיעו אלינו אחרי כישלונות – ועברו."
        buttonLabel="בוא נדבר"
        waMessage={waMessages.failedTest}
      />
    </div>
  </section>

  <ProcessSteps />
  <Reviews />
  <Faq />
  <Contact />
</BaseLayout>
